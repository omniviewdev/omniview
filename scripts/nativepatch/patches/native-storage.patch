+//go:build darwin && !ios && !server
+
+package application
+
+/*
+#include "webview_storage_darwin.h"
+#include <stdlib.h>
+*/
+import "C"
+
+import (
+	"errors"
+	"sync"
+	"sync/atomic"
+	"unsafe"
+)
+
+func validatePlatformWebviewStorageOptions(options Options) error {
+	if options.Mac.WebsiteDataStoreIdentifier == "" {
+		return nil
+	}
+	if err := validateWebsiteDataStoreIdentifier(options.Mac.WebsiteDataStoreIdentifier); err != nil {
+		return err
+	}
+	return validateWebsiteDataStoreAvailability()
+}
+
+func validateWebsiteDataStoreAvailability() error {
+	if !bool(C.wailsWebsiteDataStoreIdentifiersSupported()) {
+		return errors.New("Mac.WebsiteDataStoreIdentifier requires macOS 14 or later and a macOS 14 SDK build; explicit storage cannot use the default data store")
+	}
+	return nil
+}
+
+var websiteDataStoreRemovalID atomic.Uint64
+var websiteDataStoreRemovals sync.Map
+
+// RemoveMacWebviewDataStore schedules removal of exactly one persistent UUID
+// store. The caller must release all views using it first. It never enumerates
+// stores or clears the default store. Invalid identifiers and unsupported OS/SDK
+// versions return an error without scheduling removal or calling completion.
+//
+// The main dispatch queue must remain running until completion is called.
+// Completion runs on a separate goroutine and receives WebKit's removal error,
+// including errors for stores still in use. A nonnil completion is required.
+func RemoveMacWebviewDataStore(identifier string, completion func(error)) error {
+	if err := validateWebsiteDataStoreIdentifier(identifier); err != nil {
+		return err
+	}
+	if err := validateWebsiteDataStoreAvailability(); err != nil {
+		return err
+	}
+	if completion == nil {
+		return errors.New("website data store removal requires a completion callback")
+	}
+	id := websiteDataStoreRemovalID.Add(1)
+	websiteDataStoreRemovals.Store(id, completion)
+	cIdentifier := C.CString(identifier)
+	defer C.free(unsafe.Pointer(cIdentifier))
+	C.wailsRemoveWebsiteDataStore(cIdentifier, C.uint64_t(id))
+	return nil
+}
+
+//export completeWebsiteDataStoreRemoval
+func completeWebsiteDataStoreRemoval(id C.uint64_t, message *C.char) {
+	callback, ok := websiteDataStoreRemovals.LoadAndDelete(uint64(id))
+	if !ok {
+		return
+	}
+	var err error
+	if message != nil {
+		err = errors.New(C.GoString(message))
+	}
+	go callback.(func(error))(err)
+}
