+//go:build server
+
+package application
+
+import (
+	"log/slog"
+	"net/http"
+	"net/http/httptest"
+	"testing"
+
+	"github.com/wailsapp/wails/v3/internal/assetserver"
+)
+
+func TestServerMiddlewareBlocksEveryRouteBeforeDispatch(t *testing.T) {
+	wraps, requests := 0, 0
+	app := &App{options: Options{Server: ServerOptions{
+		Middleware: func(next http.Handler) http.Handler {
+			wraps++
+			return http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+				requests++
+				http.Error(w, "blocked", http.StatusForbidden)
+			})
+		},
+	}}}
+	// Nil downstream services deliberately panic if dispatch precedes the policy.
+	server := &serverApp{app: app}
+	handler := server.createHandler()
+	for _, path := range []string{"/health", "/wails/events", "/wails/stream/ws", "/index.html", "/wails/runtime"} {
+		t.Run(path, func(t *testing.T) {
+			response := httptest.NewRecorder()
+			handler.ServeHTTP(response, httptest.NewRequest(http.MethodGet, path, nil))
+			if response.Code != http.StatusForbidden || response.Body.String() != "blocked\n" {
+				t.Fatalf("policy did not block %s: %d %q", path, response.Code, response.Body.String())
+			}
+		})
+	}
+	if wraps != 1 || requests != 5 {
+		t.Fatalf("middleware wrapped %d times and handled %d requests", wraps, requests)
+	}
+}
+
+func TestServerNilMiddlewarePreservesHandlerBehavior(t *testing.T) {
+	assetRequests := 0
+	assets, err := assetserver.NewAssetServer(&assetserver.Options{
+		Handler: http.HandlerFunc(func(w http.ResponseWriter, r *http.Request) {
+			assetRequests++
+			w.WriteHeader(http.StatusAccepted)
+			_, _ = w.Write([]byte("asset"))
+		}),
+		Logger: slog.Default(),
+	})
+	if err != nil {
+		t.Fatal(err)
+	}
+	server := &serverApp{app: &App{assets: assets}}
+	handler := server.createHandler()
+	for _, test := range []struct {
+		path   string
+		status int
+		body   string
+	}{
+		{"/health", http.StatusOK, `{"status":"ok"}`},
+		{"/index.html", http.StatusAccepted, "asset"},
+	} {
+		response := httptest.NewRecorder()
+		handler.ServeHTTP(response, httptest.NewRequest(http.MethodGet, test.path, nil))
+		if response.Code != test.status || response.Body.String() != test.body {
+			t.Fatalf("%s: got %d %q, want %d %q", test.path, response.Code, response.Body.String(), test.status, test.body)
+		}
+	}
+	if assetRequests != 1 {
+		t.Fatalf("asset handler received %d requests, want 1", assetRequests)
+	}
+}
