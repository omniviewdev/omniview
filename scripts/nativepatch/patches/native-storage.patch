+//go:build linux || darwin
+
+package application
+
+import (
+	"errors"
+	"fmt"
+	"os"
+	"path/filepath"
+	"syscall"
+)
+
+func openWebviewCookieFile(path string) (*os.File, error) {
+	if info, err := os.Lstat(path); err == nil {
+		if !info.Mode().IsRegular() {
+			return nil, fmt.Errorf("cookie storage %q must be a regular file, not a symlink or special file", path)
+		}
+	} else if !os.IsNotExist(err) {
+		return nil, err
+	}
+	// O_NOFOLLOW rejects a final-component symlink even if the path changes
+	// after Lstat or did not exist. O_NONBLOCK prevents a concurrently substituted
+	// FIFO from hanging startup; fstat validates the object actually opened.
+	fd, err := syscall.Open(path, syscall.O_CREAT|syscall.O_RDWR|syscall.O_CLOEXEC|syscall.O_NOFOLLOW|syscall.O_NONBLOCK, 0600)
+	if err != nil {
+		return nil, &os.PathError{Op: "open", Path: path, Err: err}
+	}
+	file := os.NewFile(uintptr(fd), path)
+	info, err := file.Stat()
+	if err == nil && !info.Mode().IsRegular() {
+		err = fmt.Errorf("cookie storage %q must be a regular file", path)
+	}
+	if err != nil {
+		return nil, errors.Join(err, file.Close())
+	}
+	return file, nil
+}
+
+func prepareLinuxWebviewStorageDirectories(options LinuxOptions) error {
+	if err := validateLinuxWebviewStorage(options); err != nil {
+		return err
+	}
+	if options.WebviewDataPath == "" {
+		return nil
+	}
+	for _, path := range [...]string{options.WebviewDataPath, options.WebviewCachePath} {
+		if err := os.MkdirAll(path, 0700); err != nil {
+			return fmt.Errorf("prepare Linux webview profile directory %q: %w", path, err)
+		}
+		// WebKit's persistent-storage setters do not return filesystem errors.
+		// Reject unwritable selections rather than silently starting without persistence.
+		file, err := os.CreateTemp(path, ".wails-storage-check-*")
+		if err != nil {
+			return fmt.Errorf("Linux webview profile directory %q is not writable: %w", path, err)
+		}
+		closeErr := file.Close()
+		removeErr := os.Remove(file.Name())
+		if err := errors.Join(closeErr, removeErr); err != nil {
+			return fmt.Errorf("check Linux webview profile directory %q: %w", path, err)
+		}
+	}
+	cookiePath := filepath.Join(options.WebviewDataPath, "cookies.sqlite")
+	cookies, err := openWebviewCookieFile(cookiePath)
+	if err != nil {
+		return fmt.Errorf("prepare Linux persistent cookie storage %q: %w", cookiePath, err)
+	}
+	if err := cookies.Close(); err != nil {
+		return fmt.Errorf("close Linux persistent cookie storage %q: %w", cookiePath, err)
+	}
+	return nil
+}
