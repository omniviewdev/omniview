+		valid      bool
+	}{
+		{"", false},
+		{"00000000-0000-0000-0000-000000000000", false},
+		{"2c6027ef-4514-4df6-ae0c-636337af26e7", true},
+		{"2C6027EF-4514-4DF6-AE0C-636337AF26E7", true},
+		{"2c6027ef45144df6ae0c636337af26e7", false},
+		{"{2c6027ef-4514-4df6-ae0c-636337af26e7}", false},
+		{"2c6027ef-4514-4df6-ae0c-636337af26eg", false},
+		{" 2c6027ef-4514-4df6-ae0c-636337af26e7", false},
+	} {
+		t.Run(tt.identifier, func(t *testing.T) {
+			if err := validateWebsiteDataStoreIdentifier(tt.identifier); (err == nil) != tt.valid {
+				t.Fatalf("validation error = %v, valid = %v", err, tt.valid)
+			}
+		})
+	}
+}
+
+// Catch partial selection silently routing one half of a Linux profile to defaults.
+func TestValidateLinuxWebviewStorage(t *testing.T) {
+	root := t.TempDir()
+	data := filepath.Join(root, "data")
+	cache := filepath.Join(root, "cache")
+	for _, tt := range []struct {
+		name    string
+		options LinuxOptions
+		valid   bool
+	}{
+		{"default", LinuxOptions{}, true},
+		{"profile", LinuxOptions{WebviewDataPath: data, WebviewCachePath: cache}, true},
+		{"missing cache", LinuxOptions{WebviewDataPath: data}, false},
+		{"missing data", LinuxOptions{WebviewCachePath: cache}, false},
+		{"relative data", LinuxOptions{WebviewDataPath: "data", WebviewCachePath: cache}, false},
+		{"relative cache", LinuxOptions{WebviewDataPath: data, WebviewCachePath: "cache"}, false},
+		{"same directory", LinuxOptions{WebviewDataPath: data, WebviewCachePath: data}, false},
+		{"same cleaned directory", LinuxOptions{WebviewDataPath: data, WebviewCachePath: data + string(filepath.Separator) + "."}, false},
+		{"nul data", LinuxOptions{WebviewDataPath: data + "\x00", WebviewCachePath: cache}, false},
