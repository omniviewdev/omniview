+//go:build darwin && !ios && !server
+
+#import <Foundation/Foundation.h>
+#import <WebKit/WebKit.h>
+#import "webview_storage_darwin.h"
+
+extern void completeWebsiteDataStoreRemoval(uint64_t callbackID, const char *error);
+
+bool wailsWebsiteDataStoreIdentifiersSupported(void) {
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 140000
+    if (@available(macOS 14.0, *)) {
+        return true;
+    }
+#endif
+    return false;
+}
+
+void *wailsWebsiteDataStoreForIdentifier(const char *identifier) {
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 140000
+    if (@available(macOS 14.0, *)) {
+        NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:[NSString stringWithUTF8String:identifier]];
+        if (uuid == nil) {
+            return NULL;
+        }
+        WKWebsiteDataStore *store = [WKWebsiteDataStore dataStoreForIdentifier:uuid];
+        [uuid release];
+        return store;
+    }
+#endif
+    return NULL;
+}
+
+void wailsRemoveWebsiteDataStore(const char *identifier, uint64_t callbackID) {
+#if MAC_OS_X_VERSION_MAX_ALLOWED >= 140000
+    if (@available(macOS 14.0, *)) {
+        NSUUID *uuid = [[NSUUID alloc] initWithUUIDString:[NSString stringWithUTF8String:identifier]];
+        if (uuid == nil) {
+            completeWebsiteDataStoreRemoval(callbackID, "invalid website data store UUID");
+            return;
+        }
+        dispatch_async(dispatch_get_main_queue(), ^{
+            @autoreleasepool {
+                // The class removal API does not initialize WebKit's main
+                // RunLoop on its own. A windowless cleanup process must do so
+                // through a public ephemeral store before the IO queue posts
+                // its completion back. Never initialize a persistent default.
+                WKWebsiteDataStore *initializationStore = [WKWebsiteDataStore nonPersistentDataStore];
+                if (initializationStore == nil) {
+                    completeWebsiteDataStoreRemoval(callbackID, "could not initialize ephemeral WebKit storage");
+                    return;
+                }
+                // Remove only the explicitly owned UUID. Never enumerate
+                // stores or clear the default store.
+                [WKWebsiteDataStore removeDataStoreForIdentifier:uuid completionHandler:^(NSError *error) {
+                    completeWebsiteDataStoreRemoval(callbackID, error == nil ? NULL : [[error localizedDescription] UTF8String]);
+                }];
+            }
+        });
+        [uuid release];
+        return;
+    }
+#endif
+    completeWebsiteDataStoreRemoval(callbackID, "explicit website data stores require macOS 14 or later and a macOS 14 SDK build");
+}
