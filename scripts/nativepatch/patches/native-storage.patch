+package application
+
+import (
+	"errors"
+	"path/filepath"
+	"strings"
+)
+
+// ValidateWebviewStorageOptions validates explicit native storage selection for
+// the current platform, including native OS availability. It does not create
+// directories or webviews. Server builds do not use native webview storage.
+// Run calls this before constructing the native application or starting services.
+func ValidateWebviewStorageOptions(options Options) error {
+	return validatePlatformWebviewStorageOptions(options)
+}
+
+func validateWebsiteDataStoreIdentifier(identifier string) error {
+	if len(identifier) != 36 {
+		return errors.New("Mac.WebsiteDataStoreIdentifier must be a nonzero UUID in 8-4-4-4-12 format")
+	}
+	nonzero := false
+	for i := range len(identifier) {
+		c := identifier[i]
+		if i == 8 || i == 13 || i == 18 || i == 23 {
+			if c != '-' {
+				return errors.New("Mac.WebsiteDataStoreIdentifier must be a UUID in 8-4-4-4-12 format")
+			}
+			continue
+		}
+		if !((c >= '0' && c <= '9') || (c >= 'a' && c <= 'f') || (c >= 'A' && c <= 'F')) {
+			return errors.New("Mac.WebsiteDataStoreIdentifier must contain only hexadecimal UUID digits")
+		}
+		nonzero = nonzero || c != '0'
+	}
+	if !nonzero {
+		return errors.New("Mac.WebsiteDataStoreIdentifier must not be the zero UUID")
+	}
+	return nil
+}
+
+func validateLinuxWebviewStorage(options LinuxOptions) error {
+	data, cache := options.WebviewDataPath, options.WebviewCachePath
+	if data == "" && cache == "" {
+		return nil
+	}
+	if data == "" || cache == "" {
+		return errors.New("Linux.WebviewDataPath and Linux.WebviewCachePath must both be set for an explicit profile")
+	}
+	if strings.IndexByte(data, 0) >= 0 || strings.IndexByte(cache, 0) >= 0 || !filepath.IsAbs(data) || !filepath.IsAbs(cache) {
+		return errors.New("Linux webview data and cache paths must be absolute paths without NUL bytes")
+	}
+	if filepath.Clean(data) == filepath.Clean(cache) {
+		return errors.New("Linux webview data and cache paths must be distinct directories")
+	}
+	return nil
+}
