+//go:build linux || darwin
+
+package application
+
+import (
+	"os"
+	"path/filepath"
+	"syscall"
+	"testing"
+)
+
+// Catch following existing or dangling cookie symlinks outside the selected profile.
+func TestPrepareLinuxWebviewStorageRejectsCookieSymlink(t *testing.T) {
+	for _, existing := range []bool{true, false} {
+		name := "dangling"
+		if existing {
+			name = "existing"
+		}
+		t.Run(name, func(t *testing.T) {
+			root := t.TempDir()
+			options := LinuxOptions{WebviewDataPath: filepath.Join(root, "data"), WebviewCachePath: filepath.Join(root, "cache")}
+			if err := os.MkdirAll(options.WebviewDataPath, 0700); err != nil {
+				t.Fatal(err)
+			}
+			outside := filepath.Join(root, "outside-cookie")
+			if existing {
+				if err := os.WriteFile(outside, []byte("outside sentinel"), 0600); err != nil {
+					t.Fatal(err)
+				}
+			}
+			cookiePath := filepath.Join(options.WebviewDataPath, "cookies.sqlite")
+			if err := os.Symlink(outside, cookiePath); err != nil {
+				t.Fatal(err)
+			}
+			if err := prepareLinuxWebviewStorageDirectories(options); err == nil {
+				t.Fatal("accepted a cookie symlink outside the profile")
+			}
+			if target, err := os.Readlink(cookiePath); err != nil || target != outside {
+				t.Fatalf("cookie symlink was changed: %q, %v", target, err)
+			}
+			if existing {
+				content, err := os.ReadFile(outside)
+				if err != nil || string(content) != "outside sentinel" {
+					t.Fatalf("outside cookie sentinel changed: %q, %v", content, err)
+				}
+			} else if _, err := os.Lstat(outside); !os.IsNotExist(err) {
+				t.Fatalf("created dangling symlink target: %v", err)
+			}
+		})
+	}
+}
+
+func TestPrepareLinuxWebviewStorageRejectsCookieFIFO(t *testing.T) {
+	root := t.TempDir()
+	options := LinuxOptions{WebviewDataPath: filepath.Join(root, "data"), WebviewCachePath: filepath.Join(root, "cache")}
+	if err := os.MkdirAll(options.WebviewDataPath, 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := syscall.Mkfifo(filepath.Join(options.WebviewDataPath, "cookies.sqlite"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	if err := prepareLinuxWebviewStorageDirectories(options); err == nil {
+		t.Fatal("accepted a FIFO as persistent cookie storage")
+	}
+}
+
+// Catch silently accepting a non-directory instead of rejecting profile startup.
+func TestPrepareLinuxWebviewStorageDirectories(t *testing.T) {
+	root := t.TempDir()
+	options := LinuxOptions{WebviewDataPath: filepath.Join(root, "data"), WebviewCachePath: filepath.Join(root, "cache")}
+	if err := prepareLinuxWebviewStorageDirectories(options); err != nil {
+		t.Fatal(err)
+	}
+	for _, path := range []string{options.WebviewDataPath, options.WebviewCachePath} {
+		info, err := os.Stat(path)
+		if err != nil || !info.IsDir() {
+			t.Fatalf("profile directory %q not prepared: %v", path, err)
+		}
+		entries, err := os.ReadDir(path)
+		if err != nil {
+			t.Fatal(err)
+		}
+		if path == options.WebviewDataPath {
+			if len(entries) != 1 || entries[0].Name() != "cookies.sqlite" || entries[0].IsDir() {
+				t.Fatalf("persistent cookie file not prepared: %v", entries)
+			}
+		} else if len(entries) != 0 {
+			t.Fatalf("writability check left files in %q: %v", path, entries)
+		}
+	}
+	blocked := filepath.Join(root, "file")
+	if err := os.WriteFile(blocked, []byte("keep"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	options.WebviewCachePath = blocked
+	if err := prepareLinuxWebviewStorageDirectories(options); err == nil {
+		t.Fatal("accepted a file as a cache directory")
+	}
+	content, err := os.ReadFile(blocked)
+	if err != nil || string(content) != "keep" {
+		t.Fatalf("modified existing file: %q, %v", content, err)
+	}
+}
+
+func TestPrepareLinuxWebviewStorageRejectsInvalidCookiePath(t *testing.T) {
+	root := t.TempDir()
+	options := LinuxOptions{WebviewDataPath: filepath.Join(root, "data"), WebviewCachePath: filepath.Join(root, "cache")}
+	if err := os.MkdirAll(filepath.Join(options.WebviewDataPath, "cookies.sqlite"), 0700); err != nil {
+		t.Fatal(err)
+	}
+	if err := prepareLinuxWebviewStorageDirectories(options); err == nil {
+		t.Fatal("accepted a directory as persistent cookie storage")
+	}
+}
+
+func TestPrepareLinuxWebviewStoragePreservesExistingCookieFile(t *testing.T) {
+	root := t.TempDir()
+	options := LinuxOptions{WebviewDataPath: filepath.Join(root, "data"), WebviewCachePath: filepath.Join(root, "cache")}
+	if err := os.MkdirAll(options.WebviewDataPath, 0700); err != nil {
+		t.Fatal(err)
+	}
+	cookiePath := filepath.Join(options.WebviewDataPath, "cookies.sqlite")
+	if err := os.WriteFile(cookiePath, []byte("existing cookie data"), 0600); err != nil {
+		t.Fatal(err)
+	}
+	for range 2 {
+		if err := prepareLinuxWebviewStorageDirectories(options); err != nil {
+			t.Fatal(err)
+		}
+	}
+	content, err := os.ReadFile(cookiePath)
+	if err != nil || string(content) != "existing cookie data" {
+		t.Fatalf("cookie file changed during preparation: %q, %v", content, err)
+	}
+}
