# STAND-IN for ${ZIM_HOME}/init.zsh of Zim (zimfw/zimfw, MIT; read at b892020d091f0a6ccb5cc91cff870169063bf975). The real
# file is generated by `zimfw install` from ~/.zimrc (src/templates/zimrc:18 `zmodule termtitle`) and sources each module.
# Here the termtitle module is the upstream file, unchanged (../vendor/zim/termtitle-init.zsh, zimfw/termtitle at
# b0de7783181804d21cc73fbb109fb89e8b021327): it registers termtitle_update_precmd with add-zsh-hook and prints OSC 0.
# A prompt theme that, as Zim's prompt modules do, sets PS1 in a precmd hook (so it is redrawn at each prompt) is the tests'
# own. Not copied: the other modules, the completion, the zimfw tool.
source ${0:A:h:h}/vendor/zim/termtitle-init.zsh
autoload -Uz add-zsh-hook
function prompt_standin_precmd() {
  builtin print -r -- $? >>$HOME/framework-status
  PS1='P> '
}
add-zsh-hook precmd prompt_standin_precmd
