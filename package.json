    "react-dom": "^19.0.0",
    "react-error-boundary": "^4.0.13",
    "react-icons": "^5.6.0",
    "react-redux": "^9.1.0",
    "react-router-dom": "^6.30.0",
    "react-use": "^17.5.0",
    "systemjs": "^6.15.1",
    "tinycolor2": "^1.6.0",
    "yaml": "^2.7.1"
