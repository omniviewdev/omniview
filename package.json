{
  "name": "omniview",
  "private": true,
  "version": "0.7.4",
  "type": "module",
  "packageManager": "pnpm@12.14.0",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run bundle:yaml-worker && tsc && vite build",
    "build:dev": "vite build --minify false --mode development",
    "bundle:yaml-worker": "node scripts/bundle-yaml-worker.mjs",
    "postinstall": "pnpm run bundle:yaml-worker",
    "lint": "eslint ui packages/omniviewdev-vite-plugin/src e2e/tests e2e/playwright.config.ts --report-unused-disable-directives",
    "preview": "nx preview",
    "test": "vitest run",
    "bench": "vitest bench --config vitest.bench.config.ts",
    "bench:render": "vitest bench --config vitest.render.config.ts --run",
    "bench:app": "node bench/app/run.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.1.0",
