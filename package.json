  "devDependencies": {
    "@stylistic/eslint-plugin": "5.10.0",
    "@tanstack/react-query-devtools": "5.105.0",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
