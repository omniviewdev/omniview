{
  // Emit the curated runtime and extension contracts without the main barrel in the program. Otherwise TypeScript can name an inferred type
  // through that barrel and make plugin authors resolve the previous UI library and router. scripts/check-ui-v1.ts checks the emitted graphs.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "incremental": false,
    "tsBuildInfoFile": null,
    "noEmit": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "rootDir": "src",
    "outDir": "dist/ui-v1"
  },
  "include": ["src/ui/v1.ts", "src/ui/extensions/v1.ts", "src/ui/extensions/wire.ts"],
  "exclude": []
}
