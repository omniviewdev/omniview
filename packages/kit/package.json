{
  "name": "@omniviewdev/kit",
  "version": "0.7.4",
  "description": "Omniview component library: tokens, themes and the parts the new UI is built from.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./examples": {
      "types": "./dist/examples.d.ts",
      "import": "./dist/examples.js"
    },
    "./styles.css": "./dist/styles.css"
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "generate": "node scripts/generate.ts",
    "generate:check": "node scripts/generate.ts --check",
    "build": "pnpm run generate && vite build && tsc -p tsconfig.build.json && node scripts/check-dist.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:css": "stylelint --config stylelint.config.mjs \"src/**/*.css\" \"../../ui-next/**/*.css\"",
    "test": "vitest run",
    "api:check": "api-extractor run && api-extractor run --config api-extractor.examples.json",
    "api:update": "api-extractor run --local && api-extractor run --local --config api-extractor.examples.json",
    "verify": "pnpm run generate:check && pnpm run typecheck && pnpm run lint:css && pnpm run test && pnpm run build && pnpm run api:check"
  },
  "peerDependencies": {
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@microsoft/api-extractor": "7.60.1",
    "@rolldown/plugin-babel": "0.3.1",
    "@tanstack/react-table": "9.3.1",
    "@tanstack/react-virtual": "3.14.26",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@typescript-eslint/parser": "8.72.1",
    "@typescript/native": "npm:typescript@7.0.2",
    "@vitejs/plugin-react": "6.3.0",
    "axe-core": "^4.14.0",
    "babel-plugin-react-compiler": "1.0.0",
    "eslint": "10.13.0",
    "jsdom": "31.0.1",
    "playwright": "1.64.1",
    "postcss": "8.5.32",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "stylelint": "18.0.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "8.3.8",
    "vitest": "5.0.5"
  }
}
