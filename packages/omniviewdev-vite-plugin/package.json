{
  "name": "@omniviewdev/vite-plugin",
  "version": "0.7.4",
  "description": "Vite plugin for Omniview plugin development. Redirects shared dependency imports to the host app's singleton instances via window.__OMNIVIEW_SHARED__.",
  "license": "AGPL-3.0-only",
  "author": "Omniview",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "shims"
  ],
  "scripts": {
    "build": "pnpm run generate-shims && pnpm run check-shims && node ../../scripts/build-tsup.mjs src/index.ts --format esm,cjs --dts --clean",
    "check-shims": "tsx scripts/check-shim-exports.ts",
    "generate-shims": "tsx scripts/generate-shims.ts",
    "test": "tsx --test scripts/*.test.ts",
    "prepublishOnly": "pnpm run build"
  },
  "repository": {
    "type": "git",
    "directory": "packages/omniviewdev-vite-plugin",
    "url": "https://github.com/omniviewdev/omniview.git"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org/",
    "access": "public"
  },
  "keywords": [
    "omniview",
    "vite",
    "plugin",
    "shared-dependencies"
  ],
  "dependencies": {},
  "devDependencies": {
    "tsup": "9.0.0",
    "tsx": "4.23.15",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vite": "7.3.7",
    "@typescript/native": "npm:typescript@7.0.2",
    "esbuild": "0.28.2"
  },
  "peerDependencies": {
    "vite": "^7.3.7"
  }
}
